{
  "name": "@toolbar/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite dev --port 3000 --strictPort",
    "build": "vite build",
    "preview": "vite preview --port 3000",
    "start": "node server.js",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --experimental-strip-types scripts/migrate.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1151.0",
    "@better-auth/drizzle-adapter": "1.7.7",
    "@toolbar/shared": "workspace:*",
    "@toolbar/ui": "workspace:*",
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.4",
    "nodemailer": "10.1.0",
    "postgres": "3.4.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "6.0.0",
    "@sveltejs/kit": "3.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "24.19.2",
    "@types/nodemailer": "^8",
    "drizzle-kit": "0.31.11",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
