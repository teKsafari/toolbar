+/** Slugs given with --chukua (repeatable, or comma-separated). */
+function chukuaSlugs(argv: string[]): Set<string> {
+	const slugs = new Set<string>();
+	for (let i = 0; i < argv.length; i++) {
+		const value = argv[i].startsWith("--chukua=") ? argv[i].slice("--chukua=".length) : argv[i] === "--chukua" ? argv[++i] : undefined;
+		for (const s of (value ?? "").split(",")) if (s.trim()) slugs.add(s.trim());
+	}
+	return slugs;
+}
