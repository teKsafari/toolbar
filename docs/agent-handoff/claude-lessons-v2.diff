 const migogoro: string[] = [];
 
+/** Slugs named with `--adopt a,b` or `--adopt=a`. */
+function adoptArgs(argv: string[]): Set<string> {
+	const out = new Set<string>();
+	argv.forEach((arg, i) => {
+		const value = arg.startsWith("--adopt=") ? arg.slice(8) : arg === "--adopt" ? argv[i + 1] : undefined;
+		for (const slug of (value ?? "").split(",")) if (slug.trim()) out.add(slug.trim());
+	});
+	return out;
+}
+
+const ADOPTED = "--zamani--";
+
+/**
+ * Empty an adopted module into `moduleId`: progress follows the lesson slug,
+ * classes switch module ids, and the old module goes once it has no lessons.
+ */
+async function finishAdoption(oldModuleId: string, moduleId: string, slug: string, idBySlug: Map<string, string>) {
+	const oldLessons = await db.select({ id: lessons.id, slug: lessons.slug }).from(lessons).where(eq(lessons.moduleId, oldModuleId));
+	let moved = 0;
+	for (const old of oldLessons) {
+		const target = idBySlug.get(old.slug);
+		if (target) {
+			if ((await progressCount(old.id)) > 0) moved++;
+			await moveProgress(old.id, target, moduleId);
+		}
+		const n = await progressCount(old.id);
+		if (n > 0) {
+			migogoro.push(
+				`${slug}: somo la zamani ${old.id} (${old.slug}) halina somo lenye slug hiyo kwenye Markdown, na lina maendeleo ${n}. Halijafutwa; liongeze kama somo au lifute kwa mkono.`,
+			);
+			continue;
+		}
+		await db.delete(lessons).where(and(eq(lessons.id, old.id), sql`NOT EXISTS (SELECT 1 FROM maendeleo WHERE lesson_id = ${old.id})`));
+	}
+	await db.execute(sql`
+		UPDATE madarasa SET module_ids = (
+			SELECT COALESCE(jsonb_agg(v ORDER BY o), '[]'::jsonb) FROM (
+				SELECT CASE WHEN x = ${oldModuleId} THEN ${moduleId} ELSE x END AS v, min(o) AS o
+				FROM jsonb_array_elements_text(module_ids) WITH ORDINALITY AS t(x, o)
+				GROUP BY 1
+			) s
+		)
+		WHERE module_ids ? ${oldModuleId}
+	`);
+	await db.delete(modules).where(and(eq(modules.id, oldModuleId), sql`NOT EXISTS (SELECT 1 FROM lessons WHERE module_id = ${oldModuleId})`));
+	console.log(`  ${oldModuleId} -> ${moduleId}: moduli ya zamani imechukuliwa (maendeleo ya masomo ${moved} yamehamishwa)`);
+}
