{
  "manifest_version": 3,
  "name": "toolbar capture spike",
  "version": "0.0.1",
  "key": "",
  "permissions": ["activeTab", "scripting", "tabCapture", "offscreen", "storage", "unlimitedStorage", "desktopCapture", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "toolbar spike", "default_icon": { "32": "icon.png" } },
  "icons": { "128": "icon.png" },
  "commands": {
    "record-tab": {
      "suggested_key": { "default": "Alt+Shift+Y" },
      "description": "Record the current tab for 5 seconds"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://localhost/*"],
      "js": ["main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["http://localhost/*"],
      "js": ["flags.js", "isolated.js"],
      "run_at": "document_start"
    }
  ]
}
