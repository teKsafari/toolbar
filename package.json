{
  "name": "toolbar",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.27.0",
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "check": "pnpm -r check",
    "lint": "pnpm -r check",
    "dev": "pnpm --parallel --filter @toolbar/server --filter @toolbar/extension dev",
    "dev:server": "pnpm --filter @toolbar/server dev",
    "dev:extension": "pnpm --filter @toolbar/extension dev",
    "stack": "docker compose up -d postgres garage mailpit",
    "e2e": "pnpm --filter @toolbar/extension build:test && pnpm --filter @toolbar/e2e test"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  }
}
